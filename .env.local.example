# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# DATABASE_URL = pooled connection (app runtime)
# DIRECT_URL   = direct, non-pooled connection (Prisma migrations)
DATABASE_URL="postgresql://neondb_owner:npg_wK6I5qQxhEjk@ep-aged-bread-be57stvb.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:npg_wK6I5qQxhEjk@ep-aged-bread-be57stvb-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=""                 # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# Google sign-in (optional — no button uses it today)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Email (password reset + email verification) ──────────────────────────────
# https://resend.com/api-keys — the EMAIL_FROM domain must be verified in Resend.
# Without a key in development, emails are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Planned <noreply@getplanned.app>"

# ─── AI ───────────────────────────────────────────────────────────────────────
# Provider: "anthropic" (default) or "gemini".
AI_PROVIDER="anthropic"

# Anthropic (Claude) — https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=""
# Optional overrides. Defaults: claude-opus-5-5, medium.
# ANTHROPIC_MODEL="claude-opus-5-5"
# ANTHROPIC_EFFORT="medium"   # low | medium | high

# Google Gemini (temporarily disabled; used only when AI_PROVIDER="gemini").
# MUST be a key from a billing-enabled (paid) Google project in production:
# free-tier prompts may be used by Google for training / human review.
GEMINI_API_KEY=""
# Set to "true" only after confirming the key above is on a PAID project.
# AI is refused in production until this is set.
AI_PAID_TIER_CONFIRMED="false"
# App-wide cap on AI calls per rolling 24h (spending backstop). Default 5000.
AI_GLOBAL_DAILY_LIMIT="5000"
# Per-user hourly/daily AI limits. Off by default (testing); set "true" before launch.
AI_USER_LIMITS_ENABLED="false"

# ─── Bot protection (Cloudflare Turnstile) ────────────────────────────────────
# https://dash.cloudflare.com → Turnstile. Leave empty in development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Hostnames the widget may be solved on (comma-separated, no localhost in prod).
# Defaults to the host of NEXT_PUBLIC_APP_URL.
TURNSTILE_HOSTNAMES=""

# ─── Photo storage (Vercel Blob) ──────────────────────────────────────────────
# Create a PRIVATE Blob store (Vercel → Storage → Blob → access: Private).
BLOB_READ_WRITE_TOKEN=""

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Payments stay OFF until both flags are "true" (and keys are live).
PAYMENTS_ENABLED="false"
NEXT_PUBLIC_PAYMENTS_ENABLED="false"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_BASIC_MONTHLY_PRICE_ID="price_..."
STRIPE_BASIC_ANNUAL_PRICE_ID="price_..."
STRIPE_PREMIUM_MONTHLY_PRICE_ID="price_..."
STRIPE_PREMIUM_ANNUAL_PRICE_ID="price_..."

# ─── App / legal ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="[Company legal name]"
NEXT_PUBLIC_PRIVACY_EMAIL="privacy@getplanned.app"
